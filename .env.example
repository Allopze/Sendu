# ===========================================
# SENDU v2 - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# =============================================================================
# REQUIRED IN PRODUCTION
# =============================================================================

# Session secret - use a strong random string (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=b399106dbd4448e98e3919299729a486a5f271976c275dfcc43b86127573cefc8a169c566a2a2b1910de8894591d62f5817d7e40316abb138c6e088e9b8958d6

# Encryption key for sensitive settings (SMTP passwords, etc.)
# If not set, falls back to SESSION_SECRET. Setting a separate key is recommended.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ENCRYPTION_KEY=56a30dd228c21a699b8e2c8c86bb8797f0510c407fa598035c95656b6f92172a47c6acbc09a36a4507dac59e8fb266a66d4915a9bd2fd84753acada23cfbc595

# Public URL where the app is accessible (no trailing slash)
# Examples: https://sendu.example.com, https://files.mycompany.com
# REQUIRED in production - app will fail to start without it
PUBLIC_ORIGIN=https://sendu.lat,https://www.sendu.lat,http://localhost:3000,http://192.168.4.111:3000
ALLOWED_ORIGINS=https://sendu.lat,https://www.sendu.lat,http://localhost:3000,http://192.168.4.111:3000
SESSION_COOKIE_DOMAIN=.sendu.lat

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port
PORT=3000

# Environment: 'development' or 'production'
# In production: cookies will be secure, CORS will use PUBLIC_ORIGIN
NODE_ENV=production

# Trust proxy setting (required if behind nginx, Cloudflare, etc.)
# Set to "1" to trust the first proxy, or use "loopback" / specific IPs
# This is required for secure cookies and correct client IP detection
TRUST_PROXY=1

# Session cookie name (optional, for security through obscurity)
SESSION_COOKIE_NAME=sendu.sid

# SameSite policy for session cookie (lax|strict|none)
# - lax: recommended, allows normal navigation
# - strict: more secure but may break some flows
# - none: required if frontend/API are on different domains (requires HTTPS)
SESSION_COOKIE_SAMESITE=lax

# Secure flag for session cookie (true|false)
# IMPORTANT: 
# - Set to "true" if using HTTPS (recommended for production)
# - Set to "false" ONLY if you're using HTTP (not recommended for production!)
# If not set, defaults to true in production
SESSION_COOKIE_SECURE=true

# =============================================================================
# REGISTRO DE USUARIOS
# =============================================================================

# Permite registro público (true/false). Por defecto: false
ALLOW_PUBLIC_REGISTRATION=true

# Token para bootstrap del primer admin cuando el registro público está deshabilitado
# El primer registro con este token crea un admin y bloquea el bootstrap
ADMIN_BOOTSTRAP_TOKEN=__REPLACE_WITH_BOOTSTRAP_TOKEN__

# =============================================================================
# SMTP CONFIGURATION (Optional - for email features)
# =============================================================================

# SMTP server hostname
SMTP_HOST=smtp-relay.brevo.com

# SMTP port (usually 587 for TLS, 465 for SSL, 25 for unencrypted)
SMTP_PORT=587

# SMTP authentication
SMTP_USER=__REPLACE_WITH_SMTP_USERNAME__
SMTP_PASS=__REPLACE_WITH_SMTP_PASSWORD__

# Email sender address
SMTP_FROM=Sendu<no-reply@sendu.lat>

# =============================================================================
# OPTIONAL: REDIS (for multi-replica deployments)
# =============================================================================

# Uncomment and configure if using Redis for sessions/CSRF
# See backend/lib/csrf.js and backend/lib/guestTracking.js for migration notes
REDIS_URL=redis://localhost:6379

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# These are only used in development mode
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Storage Configuration (optional)
# Path where uploaded files will be stored (default: ./uploads)
# STORAGE_PATH=/var/data/sendu/uploads
