# ===========================================
# SENDU v2 - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Server Configuration
# --------------------
PORT=3000

# Environment: 'development' or 'production'
# In production: cookies will be secure, CORS will use PUBLIC_ORIGIN
NODE_ENV=development

# Session Configuration (REQUIRED in production)
# --------------------
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-64-character-secret-here

# Public Origin (REQUIRED in production)
# --------------------
# The public URL where your app is accessible (no trailing slash)
# Used for CORS, email links, etc.
PUBLIC_ORIGIN=https://yourdomain.com

# Storage Configuration (optional)
# --------------------
# Path where uploaded files will be stored
# Default: ./uploads
# STORAGE_PATH=/var/data/sendu/uploads

# Development Ports (optional)
# --------------------
# These are only used in development mode
BACKEND_PORT=3000
FRONTEND_PORT=5173
