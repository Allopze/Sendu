# Server port (change to the port you want the backend to run on)
PORT=3002

# Session secret for express-session (change in production)
SESSION_SECRET=dev-secret

# Public origin used for CORS in production (optional)
# Example: PUBLIC_ORIGIN=https://example.com
PUBLIC_ORIGIN=http://localhost:2000

# Storage path for uploaded files (optional)
# STORAGE_PATH=./uploads
 
# Explicit backend/frontend ports (optional)
# If set, Vite will proxy to BACKEND_PORT. FRONTEND_PORT is used for vite dev server.
BACKEND_PORT=3002
FRONTEND_PORT=2000

