# Server port (change to the port you want the backend to run on)
PORT=3002

# Environment (set to 'production' for production deployments)
NODE_ENV=development

# Session secret for express-session (REQUIRED in production - use a strong random string)
SESSION_SECRET=da4d896923416811bb758f760fce7868b26dfe8ad57a46636faac1b3c0f7e18d09323dc36a773781e6a077d35f2afa2c96db9ac5b99ae1c21e7935cee7ecc3ff

# Public origin used for CORS in production (REQUIRED in production)
# Example: PUBLIC_ORIGIN=https://example.com
PUBLIC_ORIGIN=http://localhost:2000

# Storage path for uploaded files (optional)
# STORAGE_PATH=./uploads
 
# Explicit backend/frontend ports (optional)
# If set, Vite will proxy to BACKEND_PORT. FRONTEND_PORT is used for vite dev server.
BACKEND_PORT=3002
FRONTEND_PORT=2000

