# Dockerfile for pre-built deployment
# This Dockerfile is included in the release package
# All files are already in the root, no dist/ folder needed

FROM node:20-alpine

WORKDIR /app

# Install build dependencies for native modules (better-sqlite3)
RUN apk add --no-cache python3 make g++

# Use the built-in 'node' user (UID 1000, GID 1000) for host volume compatibility
# node:20-alpine already provides user 'node' with UID/GID 1000

# Copy all files (already pre-built)
COPY package*.json ./
COPY backend/ ./backend/
COPY public/ ./public/
COPY branding/ ./branding/
COPY scripts/ ./scripts/

# Install production dependencies (rebuild native modules for Linux)
RUN npm ci --omit=dev

# Remove build dependencies to reduce image size
RUN apk del python3 make g++

# Create directories for data persistence
RUN mkdir -p /app/uploads /app/tmp /app/backend/logs /app/data /app/branding && \
    chown -R node:node /app

# Switch to non-root user
USER node

# Environment variables
ENV NODE_ENV=production
ENV PORT=4000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT}/api/health || exit 1

EXPOSE 4000

CMD ["node", "backend/server.js"]
