{
  "name": "sendu",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"backend,frontend\" --prefix-colors \"cyan,magenta\"",
    "dev:backend": "node --watch --watch-path=backend backend/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "cleanup": "node scripts/cleanup.js",
    "build": "node scripts/build.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "build:frontend": "cd frontend && npm run build",
    "postinstall": "cd frontend && npm install",
    "test": "vitest run",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "cd frontend && npm run lint",
    "lint:fix": "cd frontend && npm run lint:fix"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.1.2",
    "supertest": "^7.1.4",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "check-disk-space": "^3.4.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "file-type": "^21.3.4",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "overrides": {
    "qs": "^6.15.0",
    "path-to-regexp": "^8.4.1"
  }
}
